# Copy to terraform.tfvars for the target environment.
# Replace every applicable REPLACE_... value.
# Do not put secret payloads in this file.
#
# This stack owns shared platform state only: APIs, IAM, Secret Manager and
# observability. It does not create Agent Engines or their runtime
# configuration. Agents are built, deployed and registered from the agent
# repository's dev helpers, and each agent reads its own Parameter Manager
# parameter. Adding an agent therefore needs no change here.

# EXISTING TARGET PROJECT
project_id = "REPLACE_WITH_GCP_PROJECT_ID"
region     = "us-central1"

# SECRETS
# Keep payloads out of terraform.tfvars. Populate managed_secrets only when this
# stack owns the Secret Manager object. Supply matching TF_VAR_secret_values at apply.
#
# These are the secrets the agents read at runtime, under their own Agent
# Identity. The IDs must match deployment/registry.py (GROWTH_SECRETS and
# JIRA_API_TOKEN_SECRET). Leave accessor_members empty: each agent's release
# grants its own identity secretAccessor on its own secrets only.
#
# Issue new values for all of these for this environment; never copy keys or
# tokens from another environment.
managed_secrets = {
  BLS_API_KEY = {
    secret_id = "growth-bls-api-key"
    labels    = { agent = "growth-analysis" }
  }
  FRED_API_KEY = {
    secret_id = "growth-fred-api-key"
    labels    = { agent = "growth-analysis" }
  }
  NYT_API_KEY = {
    secret_id = "growth-nyt-api-key"
    labels    = { agent = "growth-analysis" }
  }
  GOOGLE_PLACES_API_KEY = {
    secret_id = "growth-google-places-api-key"
    labels    = { agent = "growth-analysis" }
  }
  # API token of a dedicated Atlassian service account, not a person's token.
  JIRA_API_TOKEN = {
    secret_id = "ticket-guidance-jira-api-token"
    labels    = { agent = "ticket-guidance" }
  }
}

# DEVELOPER DEPLOYMENT ACCESS
# Prefer a Google Group. Leave empty when developer deployment helpers are not used.
developer_deployer_members = [
  "group:REPLACE_WITH_DEV_GROUP@example.com",
]
developer_parameter_access    = true
developer_staging_bucket_name = "REPLACE_WITH_EXISTING_DEV_STAGING_BUCKET_NAME"

# Required when developer or runtime IAM bindings are configured.
# Organization project:
developer_agent_identity_organization_id = "REPLACE_WITH_ORGANIZATION_ID"
developer_agent_identity_orgless         = false
# Orgless project instead:
# developer_agent_identity_organization_id = null
# developer_agent_identity_orgless         = true

# BASELINE ROLES FOR EVERY AGENT IDENTITY IN THE PROJECT
# Granted through a trust-domain principal set, so agents added later inherit
# them without a Terraform change. Every role here reaches every current and
# future runtime in the project. Access to a specific bucket, dataset or secret
# belongs on the exact Agent Identity after deploy instead.
# Null uses runtime_iam_policy.json, shared with the sandbox helper.
# Storage objectViewer is granted only on developer_staging_bucket_name.
agent_identity_project_roles = null

# KITCHEN SEQUENCER TABLES
# Curated BigQuery tables that replace the Looker dashboards, rebuilt daily from
# infrastructure/sql/kitchen_compliance. After apply, the source project's owner
# must grant the output kitchen_compliance_refresh_service_account
# roles/bigquery.dataViewer on hdr_analytics. Set to null to skip.
kitchen_compliance = {
  source_project = "REPLACE_WITH_SOURCE_PROJECT_ID" # project holding hdr_analytics
  reader_members = ["group:REPLACE_WITH_KITCHEN_SEQUENCER_USERS@example.com"]
}

# OBSERVABILITY
# Covers every Agent Engine runtime in the project, grouped by runtime id.
log_bucket_id      = null
log_retention_days = 90
