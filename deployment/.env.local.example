# LOCAL WORKSTATION EXECUTION
# Run: gcloud auth application-default login
# Copy to deployment/.env.local and replace required placeholders.
# CONFIG_PARAMETER is intentionally absent; local execution reads these values directly.

# REQUIRED
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_DEV_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
ENVIRONMENT=local
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_LOCATION=global
AGENT_INSTRUCTION=You are a concise enterprise assistant.
LOG_LEVEL=DEBUG

# OPTIONAL
CONFIG_REVISION=local
MAX_ATTEMPTS=3
MAX_MODEL_CALLS_PER_REQUEST=100
CONTEXT_COMPACTION_THRESHOLD_TOKENS=100000

# Which tool calls reach the logs: off, names, argument_keys or full.
# Remote runtimes read this from Parameter Manager instead. "full" records
# arguments and results, which here are the signed-in user's own data, so keep
# it for deliberate debugging.
TOOL_CALL_LOGGING=off

# Required to construct any of the code agents. Their tools act as the
# signed-in user, so end-to-end runs need Gemini Enterprise; locally the agents
# load and answer, and a tool reports that no user token is present.
GEMINI_ENTERPRISE_AUTHORIZATION_ID=local

# Agent settings, as in deployment/config.yaml (only the agent you run needs its own).
GROWTH_SPREADSHEET_ID=
GROWTH_REPORT_FOLDER_ID=
DRIVE_SOURCE_FOLDER_ID=
DRIVE_MASTER_DICT_FOLDER_ID=
DRIVE_PROCESSED_FOLDER_ID=
CONFLUENCE_CONNECTOR_ID=
JIRA_API_BASE_URL=
JIRA_SITE_URL=
JIRA_SERVICE_ACCOUNT_EMAIL=

# Vendor Match: parallel resolver threads per chunk (default from pipeline_config.yaml).
MAX_THREADS=

# Shared runtime settings no agent here uses yet; they seed new parameters.
IMAGE_MODEL=
MAX_REFERENCE_IMAGES=5

# Secrets: name the Secret Manager secret (read with your ADC), or for an
# offline run put the value in <NAME>_VALUE. Never commit a value.
BLS_API_KEY_SECRET=growth-bls-api-key
FRED_API_KEY_SECRET=growth-fred-api-key
NYT_API_KEY_SECRET=growth-nyt-api-key
GOOGLE_PLACES_API_KEY_SECRET=growth-google-places-api-key
JIRA_API_TOKEN_SECRET=ticket-guidance-jira-api-token
